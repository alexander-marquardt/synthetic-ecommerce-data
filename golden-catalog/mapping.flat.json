{
 "mappings": {
  "dynamic": false,
  "dynamic_templates": [
   {
    "facet_values": {
     "path_match": "facets.*",
     "mapping": {
      "type": "keyword"
     }
    }
   },
   {
    "facet_numbers": {
     "path_match": "facets_num.*",
     "mapping": {
      "type": "double"
     }
    }
   }
  ],
  "properties": {
   "sku": {
    "type": "keyword"
   },
   "product_id": {
    "type": "keyword"
   },
   "product_type": {
    "type": "keyword"
   },
   "title": {
    "type": "text"
   },
   "description": {
    "type": "text"
   },
   "parent_title": {
    "type": "text"
   },
   "brand": {
    "type": "keyword"
   },
   "series": {
    "type": "keyword"
   },
   "category_path": {
    "type": "keyword"
   },
   "category_leaf": {
    "type": "keyword"
   },
   "dimension_provenance": {
    "type": "keyword"
   },
   "spec_quality": {
    "type": "keyword"
   },
   "variant_axes": {
    "type": "keyword"
   },
   "price_usd": {
    "type": "double"
   },
   "stock": {
    "type": "integer"
   },
   "image_id": {
    "type": "keyword"
   },
   "image_url": {
    "type": "keyword"
   },
   "image_detail_url": {
    "type": "keyword"
   },
   "ingredients": {
    "type": "text"
   },
   "attribute_names": {
    "type": "keyword"
   },
   "attributes": {
    "type": "object",
    "properties": {
     "key": {
      "type": "keyword"
     },
     "name": {
      "type": "keyword"
     },
     "value": {
      "type": "keyword"
     },
     "unit_code": {
      "type": "keyword"
     },
     "value_canonical": {
      "type": "double"
     }
    }
   },
   "facets": {
    "type": "object",
    "dynamic": true
   },
   "facets_num": {
    "type": "object",
    "dynamic": true
   },
   "text": {
    "type": "text"
   }
  }
 }
}
